# ============================================================================
# 《混賬》(Messy Split) v7.4 - 生產環境 HTTP 快取與資安加固標頭 (_headers)
# 適用於 Cloudflare Pages / Netlify 等靜態託管平台
# ============================================================================

# 1. 確保 Service Worker 永遠不被瀏覽器死鎖快取，每次開 App 都能立即偵測新版
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# 2. PWA Manifest 與核心 HTML / JS 模組：由 Service Worker 接管離線快取，但線上驗證時強制檢查最新版
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/db-crypto.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript; charset=utf-8

/export-backup.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript; charset=utf-8

/ocr-scanner.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# 3. 靜態應用圖示與動物角色縮圖：可長期快取，加快啟動與離線渲染速度
/icon-*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=2592000

/*.jpeg
  Cache-Control: public, max-age=2592000

# 4. 全站資安加固標頭 (含 HTTP 層級 CSP、HSTS、防嵌入釣魚與硬體權限最小化)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self' https://cdn.jsdelivr.net https://open.er-api.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' data: blob: https://open.er-api.com https://cdn.jsdelivr.net https://tessdata.projectnaptha.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';